# Maparr Environment Variables
# Copy this file to .env and adjust as needed

# --- Core Settings ---
MAPARR_DATABASE_URL=sqlite:////app/data/maparr.db
MAPARR_DATA_DIR=/app/data/maps
MAPARR_CONFIG_DIR=/app/data
MAPARR_BACKUP_DIR=/app/data/backups
MAPARR_TMP_DIR=/app/data/tmp

# --- Security ---
# Generate a strong secret: head /dev/urandom | tr -dc A-Za-z0-9_ | head -c 32
MAPARR_JWT_SECRET=your-super-secret-jwt-key-change-me-in-production
MAPARR_ALLOW_REGISTRATION=false
MAPARR_COOKIE_SECURE=true # Set false if terminating TLS elsewhere (e.g. behind proxy)

# --- Bootstrap Admin (created on first start if no users exist) ---
MAPARR_BOOTSTRAP_ADMIN_USERNAME=admin
MAPARR_BOOTSTRAP_ADMIN_PASSWORD= # Leave empty to be prompted on first run? Actually must be set; if empty, admin won't be able to login.
MAPARR_BOOTSTRAP_ADMIN_EMAIL=admin@localhost

# --- Logging ---
MAPARR_LOG_LEVEL=info # debug, info, warning, error
MAPARR_JSON_LOGS=false

# --- Optional: LDAP Authentication ---
# MAPARR_LDAP_ENABLED=false
# MAPARR_LDAP_URL=ldap://ldap.example.com:389
# MAPARR_LDAP_BIND_DN=cn=admin,dc=example,dc=com
# MAPARR_LDAP_BIND_PASSWORD=
# MAPARR_LDAP_USER_BASE_DN=ou=users,dc=example,dc=com
# MAPARR_LDAP_USER_FILTER=(uid={username})
# MAPARR_LDAP_USER_ATTR_MAP={"username": "uid", "mail": "mail"}
# MAPARR_LDAP_DEFAULT_ROLE=user

# --- Optional: OIDC ---
# (Configured via Admin UI after first login; no env vars needed)

# --- Optional: Notifications ---
# ntfy.sh
MAPARR_NOTIFICATIONS_NTFY_URL=
MAPARR_NOTIFICATIONS_NTFY_TOPIC=maparr
MAPARR_NOTIFICATIONS_NTFY_TOKEN=
# Generic webhook
MAPARR_NOTIFICATIONS_WEBHOOK_URL=
# Webhook template (optional) - not currently used

# --- Performance ---
MAPARR_DOWNLOAD_CONCURRENCY=8
MAPARR_DOWNLOAD_TIMEOUT_SECONDS=20
MAPARR_DOWNLOAD_RETRIES=3
MAPARR_DOWNLOAD_RETRY_BACKOFF=1.5
MAPARR_MAX_ACTIVE_DOWNLOADS=3
MAPARR_TLS_VERIFY=true # Set false only for testing with self-signed certs

# --- Tile Server ---
MAPARR_TILE_CACHE_SIZE=2048 # Number of tiles to keep in memory
MAPARR_TILE_CACHE_TTL=3600 # Seconds to cache tiles
MAPARR_TILE_MAX_AGE=86400 # Seconds to consider tile fresh (for caching headers)

# --- Geocoder ---
MAPARR_GEOCODE_MAX_RESULTS=12
MAPARR_GEOCODE_MAX_DISTANCE_KM=250.0

# --- Maintenance ---
MAPARR_MAINTENANCE_INTERVAL_SECONDS=3600
MAPARR_INTEGRITY_CHECK_INTERVAL_SECONDS=86400
MAPARR_BACKUP_KEEP_DAYS=30
MAPARR_MAX_MAP_BYTES=549755813888 # 512 GiB safety cap

# --- Frontend (for Vite dev server) ---
# Not used in production Docker build
VITE_API_BASE_URL=/api